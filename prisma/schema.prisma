generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
  EMPLOYEE
}

model Admin {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  password     String
  role         AdminRole
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // OTP verification
  otpCode      String?   // SHA-256 hash of the OTP
  otpExpiresAt DateTime? // Set to now() + 5 minutes on generation
  otpUsed      Boolean   @default(false) // true once the OTP has been consumed

  refreshTokens AdminRefreshToken[]
}

model AdminRefreshToken {
  id        String    @id @default(uuid())
  adminId   String
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model Customer {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  password     String
  phone        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // OTP verification
  otpCode      String?   // SHA-256 hash of the OTP
  otpExpiresAt DateTime? // Set to now() + 5 minutes on generation
  otpUsed      Boolean   @default(false) // true once the OTP has been consumed

  refreshTokens CustomerRefreshToken[]
}

model CustomerRefreshToken {
  id         String    @id @default(uuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Product {
  id                 String    @id @default(uuid())
  sku                String    @unique
  name               String
  slug               String    @unique
  description        String?
  priceCents         Int
  compareAtPriceCents Int?
  stock              Int       @default(0)
  version            Int       @default(0)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  categoryId         String
  category           Category  @relation(fields: [categoryId], references: [id])

  images             ProductImage[]
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl   String
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}